# 组合包本地构建用的 npm/pnpm 配置
#
# 为什么要关 auto-install-peers：
#   dsh 的子包（@deepseek-ai/dsh-*）在 npm 注册表上依赖图不完整 ——
#   实测 @deepseek-ai/dsh-type-meta 是 404。而 pnpm 默认会自动安装 peer
#   依赖，于是解析 @deepseek-ai/dsh-tools 时会连带去拉它缺失的 peer，直接失败。
#
#   本包把 @deepseek-ai/* 全部声明为 peer 且构建时全部 neverBundle
#   （见 tsdown.config.ts）—— 这些包在运行时由宿主 dsh 提供，
#   构建期一个都不需要装。所以关掉自动安装是正确做法，不是绕过问题。

auto-install-peers=false
strict-peer-dependencies=false
ignore-scripts=true
