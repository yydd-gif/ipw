# Source me for CI / 无 UI 调试。生产壳禁止。
#
#   set -a && . packages/dsh-yanshou-docs/scripts/headless.env && set +a
#
# 作用：让 dsh-base 自带的 approval !!js 把 policy 从 ask 变成 never，
# headless 进程不会卡在「等用户点头」。详见 overlays/ci-headless.patch.yml
# 与 README「Headless 审批」。

DSH_PERMISSION_MODE=danger-full-access
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
