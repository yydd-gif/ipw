{
  "name": "yanshou-docs",
  "productName": "验收资料编辑软件",
  "version": "0.8.0",
  "private": true,
  "description": "P7 shell + source-integrated GenOffice DOCX embed (E1 fallback)",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "prepare": "node packages/docx-embed/build.mjs",
    "embed:build": "node packages/docx-embed/build.mjs",
    "embed:typecheck": "tsc --noEmit -p vendor/genoffice/packages/pptx-engine && tsc --noEmit -p vendor/genoffice/packages/docx-engine && tsc --noEmit -p packages/docx-embed",
    "embed:gate": "node tools/run_embed_gate.mjs",
    "embed:smoke": "python3 tools/run_embed_regression.py",
    "p4:gate": "python3 tools/run_p4_gate.py",
    "p4:smoke": "python3 tools/run_p4_smoke.py",
    "p5:smoke": "python3 tools/run_p5_regression.py",
    "p6:smoke": "python3 tools/run_p6_regression.py",
    "p7:smoke": "python3 tools/run_p7_regression.py",
    "p7:health": "python3 tools/run_health.py",
    "pack": "node scripts/pack.js",
    "pack:linux": "node scripts/pack.js --linux",
    "pack:win": "node scripts/pack.js --win",
    "prepare:pack": "python3 scripts/prepare_pack.py"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.3"
  }
}
